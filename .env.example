# Postgres (container local)
POSTGRES_USER=pokedex
POSTGRES_PASSWORD=pokedex
POSTGRES_DB=pokedex
POSTGRES_PORT=5432

# Redis (container local)
REDIS_PORT=6379

# App
APP_PORT=3000

# Usada pelo Prisma a partir da máquina host (localhost).
# Dentro do container da app, o docker-compose sobrescreve para o host "postgres".
DATABASE_URL=postgresql://pokedex:pokedex@localhost:5432/pokedex?schema=public
REDIS_URL=redis://localhost:6379

# Catálogo público de cartas (TCGdex). Não precisa de chave.
TCGDEX_API_URL=https://api.tcgdex.net/v2

# Login do dono da coleção (única senha). Sem ADMIN_PASSWORD, o login fica desativado.
ADMIN_PASSWORD=troque-esta-senha
# Segredo para assinar o cookie de sessão (opcional; cai no ADMIN_PASSWORD se omitido).
AUTH_SECRET=troque-este-segredo

# Railway: Postgres, Redis, volume e migrações estão em .railway/railway.ts.
# Não copie estas URLs locais para o serviço. O Railway injeta DATABASE_URL e REDIS_URL.
